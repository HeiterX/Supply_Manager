' ЭТАП 9 — ЛОГИСТИКА
' ============================================================

package "ЭТАП 9. ПОЛНЫЙ ЖИЗНЕННЫЙ ЦИКЛ ЗАКУПКИ" #FFF3E0 {

    rectangle "WAITING_SHIPMENT\nОжидание отгрузки" as SHIPPING #FFE0B2

    rectangle "IN_TRANSIT\nТовар в пути" as TRANSIT #FFE0B2

    rectangle "Данные доставки\n\nТК\nТрек-номер\nДата отправки\nПлановая дата\nКомментарий" as DELIVERY #FFE0B2

    rectangle "READY_FOR_PICKUP\nГотов к получению" as READY #FFE0B2

    rectangle "RECEIVED\nПолучено" as RECEIVED #FFE0B2

    rectangle "HANDED_OVER\nПередано заказчику /\nна судно / подразделению" as HANDED #FFE0B2

    rectangle "CLOSED\nЗакупка полностью закрыта" as CLOSED #FFE0B2

    SHIPPING --> TRANSIT
    TRANSIT --> DELIVERY
    DELIVERY --> READY
    READY --> RECEIVED
    RECEIVED --> HANDED
    HANDED --> CLOSED
}


' ============================================================
' ЭТАП 10 — БАЗА ЗНАНИЙ
' ============================================================

package "ЭТАП 10. НАКОПЛЕНИЕ ДАННЫХ ДЛЯ AI" #FFF3E0 {

    rectangle "История закупленных\nпозиций" as KNOWITEM #FFE0B2

    rectangle "История поставщиков" as KNOWSUP #FFE0B2

    rectangle "История цен" as KNOWPRICE #FFE0B2

    rectangle "Фактические сроки\nпоставки" as KNOWDELIVERY #FFE0B2

    rectangle "Отказы / отмены /\nпроблемы поставщиков" as KNOWPROBLEM #FFE0B2

    rectangle "Использованные аналоги" as KNOWANALOG #FFE0B2

    rectangle "Внутренняя база знаний\nзакупочного отдела" as KNOWLEDGE #FFE0B2

