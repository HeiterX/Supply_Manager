@startuml
title SUPPLY MANAGER\nПолная дорожная карта разработки интеллектуальной системы закупок

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 15
skinparam defaultFontName Arial
skinparam defaultFontSize 13
skinparam ArrowColor #475569
skinparam packageStyle rectangle
skinparam linetype ortho

skinparam rectangle {
    BorderColor #64748B
    FontColor #111827
}

top to bottom direction


' ============================================================
' ГЛАВНАЯ ЦЕЛЬ
' ============================================================

rectangle "ГЛАВНАЯ ЦЕЛЬ\n\nИнтеллектуальная система поддержки закупочной деятельности\nдля закупки комплектующих и материалов судоремонта\n\nВедомость дефицита → позиции → поставщики → КП → сравнение →\nрекомендация AI → решение закупщика → заказ → оплата →\nдоставка → получение → история → накопление знаний" as GOAL #FFF2CC


' ============================================================
' ЭТАП 1 — ФУНДАМЕНТ
' ============================================================

package "ЭТАП 1. ФУНДАМЕНТ СИСТЕМЫ — ГОТОВО ✓" #E8F5E9 {

    rectangle "Архитектура ✓\n\nNext.js\nNestJS\nPostgreSQL\nPrisma\nREST API\nTypeScript" as ARCH #C8E6C9

    rectangle "Task ✓\n\nЗакупочная задача\nНомер\nНазвание\nОписание\nСтатус\nПриоритет\nДедлайн" as TASK #C8E6C9

    rectangle "Управление задачей ✓\n\nnextAction\nreminderAt\ncreatedAt / updatedAt\nclosedAt" as TASKCONTROL #C8E6C9

    rectangle "TaskActivity ✓\n\nПолная история действий\nпо закупке" as ACTIVITY #C8E6C9

    ARCH --> TASK
    TASK --> TASKCONTROL
    TASKCONTROL --> ACTIVITY
}


' ============================================================
' ЭТАП 2 — ПОЗИЦИИ
' ============================================================

package "ЭТАП 2. ПОЗИЦИИ ЗАКУПКИ — ГОТОВО ✓" #E8F5E9 {

    rectangle "TaskItem ✓\n\nОтдельная закупаемая позиция" as ITEM #C8E6C9

    rectangle "Структура позиции ✓\n\nname\npartNumber\nquantity\nunit\nnotes\nsortOrder" as ITEMDATA #C8E6C9

    rectangle "CRUD API ✓\n\nДобавить\nИзменить\nУдалить\nПолучить позиции" as ITEMCRUD #C8E6C9

    rectangle "E2E TaskItem ✓\n\nСоздание\nРедактирование\nУдаление" as ITEMTEST #C8E6C9

    ITEM --> ITEMDATA
    ITEMDATA --> ITEMCRUD
    ITEMCRUD --> ITEMTEST
}


' ============================================================
' ЭТАП 3 — ПОСТАВЩИКИ
' ============================================================

package "ЭТАП 3. ПОСТАВЩИКИ И ПРЕДЛОЖЕНИЯ — ГОТОВО ✓" #E8F5E9 {

    rectangle "Supplier ✓\n\nНазвание\nКонтакт\nТелефон\nEmail\nСайт\nПримечания" as SUPPLIER #C8E6C9

    rectangle "SupplierOffer ✓\n\nЦена\nДоставка\nСрок\nНаличие\nКомментарий\nСтатус" as OFFER #C8E6C9

    rectangle "Несколько предложений ✓\n\nОдна закупка →\nнесколько поставщиков" as OFFERS #C8E6C9

    rectangle "Выбор предложения ✓\n\nselectedOfferId\nSELECTED" as SELECTOFFER #C8E6C9

    SUPPLIER --> OFFER
    OFFER --> OFFERS
    OFFERS --> SELECTOFFER
}


' ============================================================
' ЭТАП 4 — ЗАКАЗ
' ============================================================

package "ЭТАП 4. ЗАКАЗ И ОПЛАТА — ГОТОВО ✓" #E8F5E9 {

    rectangle "PurchaseOrder ✓\n\nПоставщик\nПредложение\nЦена\nДоставка\nИтог\nСрок" as PO #C8E6C9

    rectangle "Счёт ✓\n\ninvoiceNumber\ninvoiceDate\nnotes" as INVOICE #C8E6C9

    rectangle "Передача на оплату ✓\n\nsentToPaymentAt\nWAITING_PAYMENT" as SENDPAY #C8E6C9

    rectangle "Подтверждение оплаты ✓\n\npaidAt\nWAITING_SHIPMENT" as PAY #C8E6C9

    PO --> INVOICE
    INVOICE --> SENDPAY
    SENDPAY --> PAY
}


' ============================================================
' ЭТАП 5 — СМЕНА ПОСТАВЩИКА
' ============================================================

package "ЭТАП 5. СМЕНА ПОСТАВЩИКА И ИСТОРИЯ — ГОТОВО ✓" #E8F5E9 {

    rectangle "История заказов ✓\n\nTask → PurchaseOrder[]\n\nСохраняются все\nпопытки заказа" as POHISTORY #C8E6C9

    rectangle "Активный заказ ✓\n\ncurrentPurchaseOrderId" as CURRENTPO #C8E6C9

    rectangle "Отмена до оплаты ✓\n\ncancelledAt\ncancelReason" as CANCELPO #C8E6C9

    rectangle "Смена поставщика ✓\n\nСброс выбранного предложения\nВозврат к поиску\nВыбор нового поставщика" as CHANGESUP #C8E6C9

    rectangle "Защита ✓\n\nОплаченный заказ\nнельзя отменить\nобычным сценарием" as PAYPROTECT #C8E6C9

    POHISTORY --> CURRENTPO
    CURRENTPO --> CANCELPO
    CANCELPO --> CHANGESUP
    PAY --> PAYPROTECT
}


' ============================================================
' ЭТАП 6 — ПРОБЛЕМЫ
' ============================================================

package "ВАЖНЫЕ ПРОБЛЕМЫ, КОТОРЫЕ УЖЕ РЕШИЛИ ✓" #E8F5E9 {

    rectangle "Prisma relation errors\nпри изменении схемы" as ERR1 #FFCDD2
    rectangle "Исправлены связи\nTask / PurchaseOrder ✓" as FIX1 #C8E6C9

    rectangle "Нельзя было хранить\nнесколько заказов задачи" as ERR2 #FFCDD2
    rectangle "PurchaseOrder[] +\ncurrentPurchaseOrderId ✓" as FIX2 #C8E6C9

    rectangle "P2002\nPurchaseOrder_supplierOfferId_key" as ERR3 #FFCDD2
    rectangle "Убрано ограничение\nодин SupplierOffer → один заказ ✓" as FIX3 #C8E6C9

    rectangle "Дублирование\npurchaseOrders в Prisma" as ERR4 #FFCDD2
    rectangle "Prisma schema\nисправлена и мигрирована ✓" as FIX4 #C8E6C9

    rectangle "Ручные curl-тесты\nзанимали много времени" as ERR5 #FFCDD2
    rectangle "Vitest + Supertest\nE2E автоматизация ✓" as FIX5 #C8E6C9

    ERR1 --> FIX1
    ERR2 --> FIX2
    ERR3 --> FIX3
    ERR4 --> FIX4
    ERR5 --> FIX5
}


' ============================================================
' ЭТАП 7 — ТЕСТЫ
' ============================================================

package "ЭТАП 7. АВТОМАТИЧЕСКОЕ ТЕСТИРОВАНИЕ — РАБОТАЕТ ✓" #E8F5E9 {

    rectangle "Vitest ✓" as VITEST #C8E6C9
    rectangle "Supertest ✓" as SUPERTEST #C8E6C9

    rectangle "Purchase Flow E2E ✓\n\nПоставщики\nВыбор\nЗаказ\nОплата\nСмена поставщика\nЗащита оплаты" as TESTPO #C8E6C9

    rectangle "TaskItem E2E ✓\n\nCreate\nUpdate\nDelete" as TESTITEM #C8E6C9

    rectangle "Сейчас:\n2 test files\n3 tests\n3 passed ✓" as TESTSTATUS #C8E6C9

    VITEST --> TESTPO
    SUPERTEST --> TESTPO
    VITEST --> TESTITEM
    TESTPO --> TESTSTATUS
    TESTITEM --> TESTSTATUS
}


' ============================================================
' ТЕКУЩАЯ ТОЧКА
' ============================================================

rectangle "ТЕКУЩАЯ ТОЧКА ПРОЕКТА\n\nБазовый путь закупки от создания задачи до оплаты уже работает.\nTaskItem, поставщики, предложения, выбор, заказ,\nотмена/смена поставщика, история и E2E заложены.\n\nДальше заканчиваем обычную систему закупок,\nПОСЛЕ ЧЕГО подключаем полноценный AI-слой." as NOW #FFF59D


' ============================================================
' ЭТАП 8 — UI
' ============================================================

package "ЭТАП 8. ДОВЕСТИ FRONTEND ДО ПОЛНОЦЕННОГО РАБОЧЕГО МЕСТА" #FFF3E0 {

    rectangle "Таблица TaskItem\n\nУдобный список позиций\nДобавление\nРедактирование\nУдаление" as UIITEM #FFE0B2

    rectangle "История PurchaseOrder\n\nТекущий заказ\nОтменённые заказы\nПричины отмены" as UIHISTORY #FFE0B2

    rectangle "Смена поставщика\nчерез UI\n\nБез curl и ручной работы" as UICHANGE #FFE0B2

