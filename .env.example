# Docker Compose only. Copy to .env and generate a private random password.
# Existing PostgreSQL volumes keep their existing password; this does not rotate it.
POSTGRES_PASSWORD=

# Copy Telegram settings to apps/api/.env; never expose them as NEXT_PUBLIC_*.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_URL=https://api.example.com/api/v1/telegram/webhook
FRONTEND_ORIGIN=http://localhost:3001
# Explicit routing until CORE-09 assignment policies exist. Empty means no recipients.
TELEGRAM_REQUEST_RECIPIENT_USERNAMES=
TELEGRAM_PURCHASE_RECIPIENT_USERNAMES=
