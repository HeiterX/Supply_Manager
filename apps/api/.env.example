# Copy to .env. Supply local credentials; URL-encode the password in DATABASE_URL.
DATABASE_URL=postgresql://supply:REPLACE_WITH_URL_ENCODED_PASSWORD@127.0.0.1:5432/supply_manager?schema=public
# Generate at least 32 random characters; empty deliberately prevents startup.
JWT_SECRET=
PORT=3000
FRONTEND_ORIGIN=http://localhost:3001

# Optional Telegram integration. Leave blank to disable notifications.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_OPERATOR_USERNAME=

# SMTP/IMAP are not implemented. Future private configuration names only.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# IMAP_HOST=
# IMAP_PORT=993
# IMAP_USER=
# IMAP_PASSWORD=
